title: Bernhard Moenius
new-page: true
view-if: bvp_integration >= 1 and anti_fascist_available and (not moenius_recruited or moenius_recruited == 1)
tags: advisor
choose-if: advisor_action_timer <= 0 and (not moenius_recruited or moenius_recruited == 1)
unavailable-subtitle: [? if advisor_action_timer > 0: [+ advisor_action_timer +] months until next advisor action. ?][? if bvp_integration < 1: Requires BVP Integration: Aligned (Level 1). ?][? if not anti_fascist_available: Anti-Fascist faction not unlocked. ?][? if moenius_recruited > 1: Already used this month. ?]
card-image: img/portraits/MoeniusBernhard.jpg
on-arrival: {!
if (!Q.moenius_recruited) {
    Q.moenius_recruited = 1;
    Q.anti_fascist_strength += 8;
    Q.anti_fascist_dissent -= 5;
    Q.left_strength += 3;
    Q.left_dissent -= 2;
    Q.presidential_opinion -= 3;
    if (Q.presidential_opinion < 0) Q.presidential_opinion = 0;
    Q.bvp_relations -= 5;
    if (Q.bvp_relations < 0) Q.bvp_relations = 0;
    Q.moenius_result = "Bernhard Moenius, leader of the Zentrum's Anti-Fascist wing and editor of the Catholic workers' newspaper, accepts an advisory role. The Anti-Fascist faction gains a voice in the party leadership. Anti-Fascist Strength +8, Anti-Fascist Dissent -5, Left Strength +3, Left Dissent -2, Presidential Opinion -3, BVP Relations -5. Moenius speaks with urgency: 'We cannot negotiate with those who would burn the Reichstag. Every compromise is a step toward the abyss.'";
} else {
    Q.advisor_action_timer = 6;
    Q.moenius_recruited = 2;
    Q.anti_fascist_dissent -= 2;
    Q.left_dissent -= 1;
    Q.presidential_opinion -= 1;
    if (Q.presidential_opinion < 0) Q.presidential_opinion = 0;
    Q.anti_fascist_actions_this_month += 1;
    Q.moenius_result = "Moenius coordinates Anti-Fascist actions across Catholic workers' associations and the Reichsbanner. The democratic resistance stiffens. Anti-Fascist Dissent -2, Left Dissent -1, Presidential Opinion -1. 'The Centre party must choose: the Republic or the reactionaries. There is no middle ground.'";
}
!}
go-to: moenius_event

@moenius_event
title: Moenius Consultation
new-page: true

{! Q.moenius_result !}

- @z_advisors_hub: Return to Advisors