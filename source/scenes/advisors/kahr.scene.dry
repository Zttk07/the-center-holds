title: Gustav Ritter von Kahr
new-page: true
view-if: bvp_integration >= 4 and (not kahr_recruited or kahr_recruited == 1)
tags: advisor
choose-if: advisor_action_timer <= 0 and (not kahr_recruited or kahr_recruited == 1)
unavailable-subtitle: [? if advisor_action_timer > 0: [+ advisor_action_timer +] months until next advisor action. ?][? if bvp_integration < 4: Requires BVP Integration: Unified (Level 4). ?][? if kahr_recruited > 1: Already used this month. ?]
card-image: img/portraits/KahrGustav.jpg
on-arrival: {!
if (!Q.kahr_recruited) {
    Q.kahr_recruited = 1;
    Q.bvp_relations += 15;
    if (Q.bvp_relations > 100) Q.bvp_relations = 100;
    Q.bvp_integration = 4;
    Q.barons_strength += 5;
    Q.barons_dissent -= 3;
    Q.right_strength += 5;
    Q.right_dissent -= 3;
    Q.presidential_opinion += 5;
    if (Q.presidential_opinion > 100) Q.presidential_opinion = 100;
    Q.kahr_result = "Gustav Ritter von Kahr, former Bavarian Prime Minister and architect of the 1923 right-wing authoritarian order, accepts advisory role. The ultimate symbol of BVP-Zentrum unification. BVP Relations +15, Integration: Unified, Barons Strength +5, Barons Dissent -3, Right Strength +5, Right Dissent -3, Presidential Opinion +5. Kahr's gaze is stern: 'I did not crush the Hitler putsch to see democracy prevail. I did it to save the state. You will use this unity wisely.'";
} else {
    Q.advisor_action_timer = 6;
    Q.kahr_recruited = 2;
    Q.bvp_relations += 5;
    if (Q.bvp_relations > 100) Q.bvp_relations = 100;
    Q.presidential_opinion += 2;
    if (Q.presidential_opinion > 100) Q.presidential_opinion = 100;
    Q.barons_dissent -= 1;
    Q.right_dissent -= 1;
    Q.kahr_result = "Kahr monitors the Bavarian-Reich boundary and the nationalist right. His authority keeps the DNVP's Bavarian wing in check. BVP Relations +5, Presidential Opinion +2, Barons Dissent -1, Right Dissent -1. 'Order is not given. It is imposed. Daily.'";
}
!}
go-to: kahr_event

@kahr_event
title: Kahr Consultation
new-page: true

{! Q.kahr_result !}

- @z_advisors_hub: Return to Advisors