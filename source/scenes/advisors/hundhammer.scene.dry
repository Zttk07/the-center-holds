title: Ferdinand Hundhammer
new-page: true
view-if: bvp_integration >= 1 and anti_fascist_available and (not hundhammer_recruited or hundhammer_recruited == 1)
tags: advisor
choose-if: advisor_action_timer <= 0 and (not hundhammer_recruited or hundhammer_recruited == 1)
unavailable-subtitle: [? if advisor_action_timer > 0: [+ advisor_action_timer +] months until next advisor action. ?][? if bvp_integration < 1: Requires BVP Integration: Aligned (Level 1). ?][? if not anti_fascist_available: Anti-Fascist faction not unlocked. ?][? if hundhammer_recruited > 1: Already used this month. ?]
card-image: img/portraits/HundhammerFerdinand.jpg
on-arrival: {!
if (!Q.hundhammer_recruited) {
    Q.hundhammer_recruited = 1;
    Q.anti_fascist_strength += 6;
    Q.anti_fascist_dissent -= 4;
    Q.center_strength += 2;
    Q.center_dissent -= 2;
    Q.christian_unity_dissent += 2;
    Q.presidential_opinion -= 2;
    if (Q.presidential_opinion < 0) Q.presidential_opinion = 0;
    Q.bvp_relations -= 3;
    if (Q.bvp_relations < 0) Q.bvp_relations = 0;
    Q.hundhammer_result = "Ferdinand Hundhammer, Bavarian Catholic trade unionist and future CSU co-founder, joins as Anti-Fascist advisor. His credibility with Catholic workers and Bavarian networks bridges the Anti-Fascist and Center factions. Anti-Fascist Strength +6, Anti-Fascist Dissent -4, Center Strength +2, Center Dissent -2, Christian Unity Dissent +2, Presidential Opinion -2, BVP Relations -3. Hundhammer is pragmatic: 'The workers will not follow a party that blesses Hindenburg's emergency decrees. We must be their shield, not their chaplain.'";
} else {
    Q.advisor_action_timer = 6;
    Q.hundhammer_recruited = 2;
    Q.anti_fascist_strength += 1;
    Q.anti_fascist_dissent -= 1;
    Q.center_dissent -= 1;
    Q.presidential_opinion -= 1;
    if (Q.presidential_opinion < 0) Q.presidential_opinion = 0;
    Q.anti_fascist_actions_this_month += 1;
    Q.hundhammer_result = "Hundhammer organizes Catholic worker delegations to Berlin. Their presence forces the party to confront social questions it would rather ignore. Anti-Fascist Strength +1, Anti-Fascist Dissent -1, Center Dissent -1, Presidential Opinion -1. 'A party that fears its own base has already lost the election.'";
}
!}
go-to: hundhammer_event

@hundhammer_event
title: Hundhammer Consultation
new-page: true

{! Q.hundhammer_result !}

- @z_advisors_hub: Return to Advisors