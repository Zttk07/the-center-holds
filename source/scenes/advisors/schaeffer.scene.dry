title: Fritz Schäffer
new-page: true
view-if: bvp_integration >= 3 and (not schaeffer_recruited or schaeffer_recruited == 1)
tags: advisor
choose-if: advisor_action_timer <= 0 and (not schaeffer_recruited or schaeffer_recruited == 1)
unavailable-subtitle: [? if advisor_action_timer > 0: [+ advisor_action_timer +] months until next advisor action. ?][? if bvp_integration < 3: Requires BVP Integration: Enmeshed (Level 3). ?][? if schaeffer_recruited > 1: Already used this month. ?]
card-image: img/portraits/SchaefferFritz.jpg
on-arrival: {!
if (!Q.schaeffer_recruited) {
    Q.schaeffer_recruited = 1;
    Q.bvp_relations += 10;
    if (Q.bvp_relations > 100) Q.bvp_relations = 100;
    Q.bvp_integration = Math.max(Q.bvp_integration, 3);
    Q.right_strength += 3;
    Q.right_dissent -= 2;
    Q.budget += 1;
    Q.moderate_plan_support += 5;
    Q.schaeffer_result = "Fritz Schäffer, BVP finance expert and future CSU co-founder, joins as advisor. His mastery of public finance and Bavarian-Catholic networks deepens integration. BVP Relations +10, Integration secured at Enmeshed or higher, Right Strength +3, Right Dissent -2, Budget +1, Moderate Plan Support +5. Schäffer is precise: 'A sound currency and a sound federation are the same thing. We shall have both.'";
} else {
    Q.advisor_action_timer = 6;
    Q.schaeffer_recruited = 2;
    Q.bvp_relations += 5;
    if (Q.bvp_relations > 100) Q.bvp_relations = 100;
    Q.budget += 1;
    Q.right_dissent -= 1;
    Q.schaeffer_result = "Schäffer reviews fiscal policy and Bavarian transfer negotiations. The BVP's financial discipline strengthens the coalition. BVP Relations +5, Budget +1, Right Dissent -1. 'Every pfennig accounted for. Every Bavarian interest protected.'";
}
!}
go-to: schaeffer_event

@schaeffer_event
title: Schäffer Consultation
new-page: true

{! Q.schaeffer_result !}

- @z_advisors_hub: Return to Advisors