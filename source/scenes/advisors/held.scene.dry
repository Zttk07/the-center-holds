title: Heinrich Held
new-page: true
view-if: bvp_integration >= 2 and (not held_recruited or held_recruited == 1)
tags: advisor
choose-if: advisor_action_timer <= 0 and (not held_recruited or held_recruited == 1)
unavailable-subtitle: [? if advisor_action_timer > 0: [+ advisor_action_timer +] months until next advisor action. ?][? if bvp_integration < 2: Requires BVP Integration: Associated (Level 2). ?][? if held_recruited > 1: Already used this month. ?]
card-image: img/portraits/HeldHeinrich.jpg
on-arrival: {!
if (!Q.held_recruited) {
    Q.held_recruited = 1;
    Q.bvp_relations += 10;
    if (Q.bvp_relations > 100) Q.bvp_relations = 100;
    Q.bvp_integration = Math.max(Q.bvp_integration, 2);
    Q.center_strength += 3;
    Q.center_dissent -= 2;
    Q.christian_unity_strength += 2;
    Q.christian_unity_dissent -= 2;
    Q.held_result = "Ministerpräsident Heinrich Held of Bavaria joins as advisor. The BVP's dominant figure brings Bavarian autonomy and Catholic conservatism into alignment with the Zentrum. BVP Relations +10, Integration secured at Associated or higher, Center Strength +3, Center Dissent -2, Christian Unity Strength +2, Christian Unity Dissent -2. Held speaks deliberately: 'Berlin forgets Bavaria at its peril. I am here to ensure it does not.'";
} else {
    Q.advisor_action_timer = 6;
    Q.held_recruited = 2;
    Q.bvp_relations += 5;
    if (Q.bvp_relations > 100) Q.bvp_relations = 100;
    Q.center_dissent -= 1;
    Q.christian_unity_dissent -= 1;
    Q.held_result = "Held advises on Bavarian-Reich relations and Catholic social teaching. The BVP's confidence in the Zentrum grows. BVP Relations +5, Center Dissent -1, Christian Unity Dissent -1. 'Subsidiarity is not a slogan, Minister. It is the architecture of Catholic order.'";
}
!}
go-to: held_event

@held_event
title: Held Consultation
new-page: true

{! Q.held_result !}

