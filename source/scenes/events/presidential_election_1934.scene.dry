?]
[? if election_1934_runoff == 0 and election_1934_winner == "Zentrum":
- @z_wins_1934_round1: Zentrum victory in first round.
?]
[? if election_1934_runoff == 0 and election_1934_winner == "SPD":
- @game_over_1934: Continue to game resolution.
?]
[? if election_1934_runoff == 0 and election_1934_winner == "NSDAP":
- @game_over_1934: Continue to game resolution.
?]
[? if election_1934_runoff == 0 and election_1934_winner == "Right":
- @game_over_1934: Continue to game resolution.
?]

@election_1934_runoff
new-page: true
on-arrival: {!
// Runoff: top two candidates
// Simplified: NSDAP vs whoever is second
var candidates = [
    {name: "NSDAP", votes: Q.election_1934_nsdap_pct, key: "NSDAP"},
    {name: "SPD", votes: Q.election_1934_spd_pct, key: "SPD"},
    {name: "Zentrum", votes: Q.election_1934_z_pct, key: "Zentrum"},
    {name: "Right", votes: Q.election_1934_right_pct, key: "Right"}
];
candidates.sort((a,b) => b.votes - a.votes);
var first = candidates[0];
var second = candidates[1];

// Runoff dynamics: democratic parties unite against NSDAP
var first_votes = first.votes;
var second_votes = second.votes;

if (first.key == "NSDAP") {
    // NSDAP vs democratic candidate
    if (second.key == "SPD") {
        second_votes += Q.election_1934_z_pct * 0.8 + Q.election_1934_right_pct * 0.1;
    } else if (second.key == "Zentrum") {
        second_votes += Q.election_1934_spd_pct * 0.7 + Q.election_1934_right_pct * 0.2;
    } else if (second.key == "Right") {
        second_votes += Q.election_1934_spd_pct * 0.1 + Q.election_1934_z_pct * 0.3;
    }
} else if (second.key == "NSDAP") {
    // Democratic candidate vs NSDAP
    if (first.key == "SPD") {
        first_votes += Q.election_1934_z_pct * 0.8 + Q.election_1934_right_pct * 0.1;
    } else if (first.key == "Zentrum") {
        first_votes += Q.election_1934_spd_pct * 0.7 + Q.election_1934_right_pct * 0.2;
    } else if (first.key == "Right") {
        first_votes += Q.election_1934_spd_pct * 0.1 + Q.election_1934_z_pct * 0.3;
    }
} else {
    // Two democratic candidates - unlikely but handle
    first_votes += second_votes * 0.5;
}

var total_runoff = first_votes + second_votes;
var runoff_winner = (first_votes > second_votes) ? first.key : second.key;

Q.election_1934_runoff_winner = runoff_winner;
Q.election_1934_runoff_first_pct = Math.round(first_votes / total_runoff * 100);
Q.election_1934_runoff_second_pct = Math.round(second_votes / total_runoff * 100);
Q.runoff_first_name = first.name;
Q.runoff_second_name = second.name;
!}

= Election 1934 Runoff

<b>Runoff:</b> [+ runoff_first_name +] vs [+ runoff_second_name +]

[+ runoff_first_name +]: [+ election_1934_runoff_first_pct +]%
[+ runoff_second_name +]: [+ election_1934_runoff_second_pct +]%

[? if election_1934_runoff_winner == "NSDAP": <span style="color: #7A3C00;">The NSDAP wins the runoff. Adolf Hitler (or proxy) becomes President. The Republic is doomed.</span> ?]
[? if election_1934_runoff_winner == "SPD": The SPD wins the runoff. Otto Braun becomes President. Democracy survives. ?]
[? if election_1934_runoff_winner == "Zentrum": The Zentrum wins the runoff. [+ z_candidate_1934_disp +] becomes President. A Catholic Chancellor-President era begins. ?]
[? if election_1934_runoff_winner == "Right": The Right wins the runoff. [+ reactionary_candidate_1934_disp +] becomes President. Authoritarian rule deepens. ?]

[? if election_1934_runoff_winner == "Zentrum":
- @z_wins_1934_runoff: Zentrum victory in runoff.
?]
[? if election_1934_runoff_winner != "Zentrum":
- @game_over_1934: Continue to game resolution.
?]

@z_wins_1934_runoff
