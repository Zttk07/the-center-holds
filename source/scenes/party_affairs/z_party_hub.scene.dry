}
!}
go-to: z_electoral_event

@z_electoral_event
title: Electoral Planning
new-page: true
on-arrival: {!
var roll = Math.random();
// Malus reduces effectiveness
var malus_penalty = 0;
if (Q.z_in_government != 1 && Q.out_of_government_malus > 0) {
    malus_penalty = Math.floor(Q.out_of_government_malus / 10);
}
if (roll < 0.25) {
    Q.left_strength = Math.min(100, Q.left_strength + Math.max(0, 3 - malus_penalty));
    if (Q.anti_fascist_available) {
        Q.anti_fascist_strength = Math.min(100, Q.anti_fascist_strength + Math.max(0, 2 - malus_penalty));
        Q.z_electoral_text = "Strategy leans social-democratic. Left and Anti-Fascist factions energized.";
    } else {
        Q.z_electoral_text = "Strategy leans social-democratic. Left faction energized. (Anti-Fascist faction locked)";
    }
} else if (roll < 0.5) {
    Q.center_strength = Math.min(100, Q.center_strength + Math.max(0, 3 - malus_penalty));
    Q.christian_unity_strength = Math.min(100, Q.christian_unity_strength + Math.max(0, 2 - malus_penalty));
    Q.z_electoral_text = "Centrist Catholic platform chosen. Center and Christian Unity strengthened.";
} else if (roll < 0.75) {
    Q.right_strength = Math.min(100, Q.right_strength + Math.max(0, 3 - malus_penalty));
    Q.christian_unity_strength = Math.min(100, Q.christian_unity_strength + Math.max(0, 1 - malus_penalty));
    Q.z_electoral_text = "Conservative-Catholic appeal selected. Right faction gains, Christian Unity modestly.";
} else {
    if (Q.anti_fascist_available) {
        Q.anti_fascist_strength = Math.min(100, Q.anti_fascist_strength + Math.max(0, 4 - malus_penalty));
        Q.left_strength = Math.min(100, Q.left_strength + Math.max(0, 1 - malus_penalty));
        Q.z_electoral_text = "Anti-fascist democratic front emphasized. Anti-Fascist faction surges."
    } else {
        Q.left_strength = Math.min(100, Q.left_strength + Math.max(0, 2 - malus_penalty));
        Q.z_electoral_text = "Anti-fascist platform considered but Anti-Fascist faction not yet unlocked. Left faction gains instead."
    }
}
if (malus_penalty > 0) {
    Q.z_electoral_text += " <span style=\"color:#8B0000;\">Out-of-government malus hampers electoral outreach.</span>";
}
!}

{! Q.z_electoral_text !}

- @z_party_hub: Return to Party Affairs